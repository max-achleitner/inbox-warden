{
  "name": "inbox-warden",
  "version": "0.6.0",
  "description": "Email for Claude and other AI assistants: search, read, organise, draft and send via IMAP/SMTP, with permission tiers, an audit log and prompt-injection screening.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "inbox-warden": "dist/bin.js",
    "imap-mcp-server": "dist/index.js",
    "imap-mcp-setup": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "PRIVACY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/bin.js serve",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "setup": "node dist/bin.js setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "doctor": "node dist/bin.js doctor",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "smoke:mcpb": "node scripts/smoke-mcpb.mjs build/mcpb",
    "sign:mcpb": "node scripts/sign-mcpb.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "version": "node scripts/sync-versions.mjs && git add plugin/.claude-plugin/plugin.json",
    "release-notes": "node scripts/release-notes.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcpb",
    "imap",
    "smtp",
    "email",
    "gmail",
    "microsoft-365",
    "claude",
    "inbox-warden"
  ],
  "author": "Max Achleitner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-achleitner/inbox-warden.git"
  },
  "homepage": "https://github.com/max-achleitner/inbox-warden#readme",
  "bugs": {
    "url": "https://github.com/max-achleitner/inbox-warden/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/server": "^2.3.1",
    "@napi-rs/keyring": "^2.1.1",
    "html-to-text": "^9.0.5",
    "imapflow": "^2.4.2",
    "jose": "^6.2.12",
    "mailparser": "^3.9.39",
    "nodemailer": "^10.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "selfsigned": "^5.5.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  }
}
